# Google AI Studio (Gemini). Never use Anthropic/Claude keys here.
GEMINI_API_KEY=
# "gemini-flash-latest" always points at Google's current Flash model; see
# https://ai.google.dev/gemini-api/docs/models for a pinned-version alternative.
GEMINI_MODEL=gemini-flash-latest

# Supabase project settings (Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret the GitHub Actions / Vercel cron must send as a Bearer token
CRON_SECRET=

# Pipeline tuning
LOOKBACK_HOURS=24
MAX_ARTICLES_PER_RUN=40
