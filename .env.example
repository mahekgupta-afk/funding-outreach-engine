# Google AI Studio (Gemini). Never use Anthropic/Claude keys here.
GEMINI_API_KEY=
# "gemini-flash-lite-latest" always points at Google's current Flash-Lite model.
# Flash-Lite is used (not plain "gemini-flash-latest"/full Flash) because the
# full Flash model's free tier is extremely limited (~20 requests/day as of
# testing in Oct 2026) — nowhere near enough for a pipeline running every
# 2 hours. Flash-Lite's free tier is far higher (several hundred to ~1500
# requests/day) and is still plenty capable for this pipeline's extraction/
# scoring/drafting prompts. See https://ai.google.dev/gemini-api/docs/models
# for a pinned-version alternative if you want to avoid a silent model bump.
GEMINI_MODEL=gemini-flash-lite-latest

# Supabase project settings (Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret the GitHub Actions / Vercel cron must send as a Bearer token
CRON_SECRET=

# Pipeline tuning
LOOKBACK_HOURS=24
MAX_ARTICLES_PER_RUN=40
